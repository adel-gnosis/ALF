# =========================
# ALF Monorepo .gitignore
# =========================
.pnpm/

# --- Node / pnpm / turbo ---
node_modules/
.pnpm-store/
.turbo/
dist/
build/
coverage/
*.log

# Next.js
.next/
out/

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.keystore

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Python / Django ---
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.pytest_cache/

# Virtual envs
venv/
.venv/

# Local DB / media
db.sqlite3
*.sqlite3
media/

# Django compiled translations
*.mo

# Archives
*.zip

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local dumps / exports
apps/backend/*dump*.json
